# === SUPABASE ===
# Obtén estos valores de https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === JWT ===
# Genera un JWT_SECRET seguro (mínimo 32 caracteres, caracteres aleatorios)
# En desarrollo: openssl rand -base64 32
# En producción: usar un generador seguro
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-random

# Duración del access token (15 minutos recomendado)
# Formatos válidos: "1h", "15m", "7d", etc.
JWT_EXPIRES_IN=15m

# === SERVER ===
# Puerto donde corre el servidor
PORT=3000

# === ALLOWED ORIGINS (para CORS) ===
# Separar múltiples orígenes con comas
# Ejemplo: http://localhost:3000,https://myapp.com
ALLOWED_ORIGINS=http://localhost:3000

# === NODE ENVIRONMENT ===
# Valores: development, production, test
NODE_ENV=development
